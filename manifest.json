{
  "manifest_version": 3,
  "name": "YouTube Comment Section Blocker",
  "version": "1.0",
  "description": "Hides the comment section on YouTube.",
  "permissions": ["scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}
